# Copia este archivo a .env.local y completa los valores.
# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# Solo la clave pública (anon / publishable). NUNCA la service_role / secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dirección pública del sitio, para el QR y los enlaces. Opcional: si falta se usa el dominio de
# producción de Vercel. Ponla cuando haya dominio propio, ej. https://menu.starcklabs.com
SITE_URL=

# Evolution API (WhatsApp) y el agente de panaderías (agente/). SOLO servidor: nunca con prefijo NEXT_PUBLIC_.
# EVOLUTION_API_URL debe ser https (http solo para localhost en pruebas).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Dirección a la que Evolution manda los mensajes (la ve Evolution, no internet: http://agente:3000/webhook)
# y el secreto que el agente exige en la cabecera x-webhook-secret (el mismo que en agente/.env).
AGENTE_WEBHOOK_URL=
AGENTE_WEBHOOK_SECRET=
