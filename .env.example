# Copia este archivo a .env.local y completa los valores.
# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# Solo la clave pública (anon / publishable). NUNCA la service_role / secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dirección pública del sitio, para el QR y los enlaces. Opcional: si falta se usa el dominio de
# producción de Vercel. Ponla cuando haya dominio propio, ej. https://menu.starcklabs.com
SITE_URL=
