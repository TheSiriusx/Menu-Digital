# Copia este archivo a .env y complétalo. NUNCA subas .env al repositorio (está en .gitignore).
# Genera cada secreto con:  openssl rand -hex 32

# ----- Supabase (el menú digital). La clave de SERVICIO da acceso total: solo aquí.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=

# ----- Evolution API (WhatsApp)
EVOLUTION_API_KEY=
# Dirección pública de Evolution (la que usa la web para el QR). En local sin túnel: http://localhost:8090
EVOLUTION_URL_PUBLICA=http://localhost:8090
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ----- Agente
# Secreto que Evolution manda en cada mensaje (el MISMO que AGENTE_WEBHOOK_SECRET en Vercel).
AGENTE_WEBHOOK_SECRET=
# Para /interno/avisos (tareas programadas). Opcional.
AGENTE_INTERNO_SECRET=
# Enlace del menú que se le manda al cliente: {MENU_URL}/{slug}
MENU_URL=https://menu-digital-inky-ten.vercel.app

# ----- IA (OpenRouter). Modelos en orden de preferencia; si uno falla se usa el siguiente.
OPENROUTER_API_KEY=
OPENROUTER_MODELOS=nvidia/nemotron-3-super-120b-a12b:free,nex-agi/nex-n2.5-pro:free,nvidia/nemotron-3.5-lightning:free

# ----- Whisper: tiny | base | small (con poca RAM, no pasar de base)
WHISPER_MODELO=base
